{
  // Cloudflare Workers static assets config for the React/Vite frontend
  "name": "tarot",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./apps/frontend/dist",
    // SPA mode: unmatched routes serve index.html so React Router can handle them
    "not_found_handling": "single-page-application"
  }
}
