# Root env file is loaded by the backend. Never put server secrets in VITE_* variables.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=file:./prisma/dev.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_CHUNK_SIZE=1100
RAG_CHUNK_OVERLAP=160
RAG_MAX_CONTEXT_CHARS=9000
AI_DAILY_LIMIT_PER_USER=8
GEMINI_TIMEOUT_MS=90000
VITE_API_BASE_URL=http://localhost:3000/api/v1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
